# ---- LLM provider keys (config/models.yaml names which env var each tier uses via api_key_env)
NVIDIA_API_KEY=                              # free tier: build.nvidia.com (nvapi-...)
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=

# Optional Jev baseline (TypeSafe AI). Leave empty to skip.
JEV_API_KEY=

# Hugging Face (only if Laya weights become gated)
HF_TOKEN=

# ---- Dataset generation
DATASET_BUDGET_USD=12.00

# ---- Server (server/app.py + proxy)
ALLOWED_ORIGINS=http://localhost:3000        # comma-separated; the Vercel domain in production
DAILY_SPEND_CAP_USD=3.00                     # public demo stops calling models after this (UTC day)
PROXY_RATE_PER_MIN=120                       # per IP, /v1/chat/completions
ROUTE_RATE_PER_MIN=30                        # per IP, /route
ANSWER_RATE_PER_MIN=6                        # per IP, /answer (live demo)
MAX_PROMPT_CHARS=4000                        # live demo text box
MAX_REQUEST_CHARS=400000                     # proxy messages (agent contexts are large)
SESSION_TTL_S=7200                           # sticky routing per conversation
PROXY_API_KEY=                               # optional: require "Authorization: Bearer <key>" on the proxy
ROUTER_DEVICE=cpu
SERVE_DIR=router/serve                       # trained deltas + modes.json (python -m router.serve_policy --export)
SERVE_LAMBDAS=                               # optional subset of lambdas to load
STATS_PATH=server/stats.json                 # cumulative routed-request stats (Savings Counter)
