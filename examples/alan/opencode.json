{
  "$schema": "https://opencode.ai/config.json",
  "model": "pennywise/auto",
  "provider": {
    "pennywise": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Pennywise",
      "options": {
        "baseURL": "https://YOUR-DEPLOYMENT/v1",
        "apiKey": "{env:PENNYWISE_KEY}"
      },
      "models": {
        "auto": { "name": "Laya auto (RL-routed)", "limit": { "context": 32000, "output": 8192 } },
        "auto-cheap": { "name": "Laya auto-cheap", "limit": { "context": 32000, "output": 8192 } },
        "auto-quality": { "name": "Laya auto-quality", "limit": { "context": 32000, "output": 8192 } },
        "large": { "name": "Large tier (no routing, for 'before' runs)", "limit": { "context": 32000, "output": 8192 } }
      }
    }
  },
  "mcp": {
    "pennywise": {
      "type": "local",
      "command": ["python", "-m", "integrations.mcp.server"],
      "enabled": true,
      "environment": { "PENNYWISE_URL": "https://YOUR-DEPLOYMENT" }
    }
  }
}
